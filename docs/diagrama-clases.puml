@startuml
title Motor de inferencia lógico-proposicional

enum FormulaKind {
  Atom
  Not
  And
  Or
  Implies
  Iff
}

class Formula {
  - kind_ : FormulaKind
  - atomName_ : string
  - left_ : Ptr
  - right_ : Ptr
  + atom(name : string) : Ptr
  + unary(kind : FormulaKind, operand : Ptr) : Ptr
  + binary(kind : FormulaKind, left : Ptr, right : Ptr) : Ptr
  + evaluate(model : map<string, bool>) : bool
  + collectAtoms(atoms : set<string>) : void
  + toString() : string
}

class FormulaParser {
  + parse(expression : string) : Formula::Ptr
}

class NaturalLanguageTranslator {
  + translate(sentence : string) : string
  - normalize(text : string) : string
}

class SemanticTree {
  - formula_ : Formula::Ptr
  + render() : string
}

struct ParsedRule {
  + original : string
  + translated : string
  + formula : Formula::Ptr
}

struct ModelReport {
  + atoms : vector<string>
  + models : vector<map<string, bool>>
  + oneHotModels : vector<vector<bool>>
  + satisfiable() : bool
  + toString() : string
}

class ModelEvaluator {
  + evaluate(formulas : vector<Formula::Ptr>) : ModelReport
}

class LogicEngine {
  - translator_ : NaturalLanguageTranslator
  - parser_ : FormulaParser
  - rules_ : vector<ParsedRule>
  + addRule(rule : string) : ParsedRule
  + evaluate() : ModelReport
  + semanticTree() : string
  + rules() : vector<ParsedRule>
}

LogicEngine *-- NaturalLanguageTranslator
LogicEngine *-- FormulaParser
LogicEngine o-- ParsedRule
ParsedRule --> Formula
FormulaParser ..> Formula : crea
SemanticTree --> Formula
ModelEvaluator ..> Formula : evalúa
ModelEvaluator ..> ModelReport : genera
Formula --> FormulaKind

@enduml
